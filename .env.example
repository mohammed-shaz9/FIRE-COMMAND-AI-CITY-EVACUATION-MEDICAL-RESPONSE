# Copy to .env (git-ignored) and fill in. Every key is optional: the app degrades gracefully without them.

# --- Server ---
# Gemini key. Missing = every agent uses its rule-based fallback.
GOOGLE_AI_KEY=
# Optional model override (default gemini-2.0-flash). Use e.g. gemini-2.5-flash if the default is retired.
GEMINI_MODEL=
# Default 3000. In production the server binds strictly to this.
PORT=3000
# development | production
NODE_ENV=development
# true = every request is a guest user (needed for protected procedures outside development)
BYPASS_AUTH=
# true = canned LLM responses for some schemas
DEMO_MODE=

# --- Client (build-time, exposed to the browser) ---
# Absolute backend URL when the client is hosted separately (e.g. Vercel). Leave empty for same origin.
VITE_BACKEND_URL=
# Google Maps embed in GeospatialMap. Missing = keyless satellite embed.
VITE_GOOGLE_MAPS_API_KEY=
# Only used by Heatmap2D, which is not mounted by any route yet.
VITE_MAPBOX_TOKEN=
